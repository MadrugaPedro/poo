@startuml
title Exercício 1 — Iluminação de uma loja
skinparam classAttributeIconSize 0
hide empty members

class IluminacaoLoja {
  - setor: String
  - potenciaEmWatts: double
  - ligada: boolean
  + IluminacaoLoja(setor: String, potenciaEmWatts: double)
  + ligar(): void
  + desligar(): void
  + obterSetor(): String
  + obterPotenciaEmWatts(): double
  + estaLigada(): boolean
}

class IluminacaoLojaApp {
  + {static} main(args: String[]): void
  - {static} exibir(iluminacao: IluminacaoLoja): void
}

IluminacaoLojaApp ..> IluminacaoLoja : cria e utiliza
@enduml
